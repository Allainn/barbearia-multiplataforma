{
  "description": "Lista de requests recentes com tempo total, status e trace completo — OpenTelemetry → Tempo",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":0},"id":5,"title":"CI/CD — Versão em Produção (barbearia-service)","type":"row"},
    {
      "datasource":{"type":"tempo","uid":"tempo"},
      "gridPos":{"h":14,"w":24,"x":0,"y":1},"id":50,
      "options":{"frameType":"traceList"},
      "title":"Requests por versão — confirma qual deploy está ativo",
      "description":"A coluna 'Versão' mostra o hash do commit (service.version) do container que processou cada request. Após ./demo-ci-verde.sh, a versão muda.",
      "type":"table",
      "targets":[{
        "datasource":{"type":"tempo","uid":"tempo"},
        "queryType":"traceql",
        "query":"{resource.service.name=\"barbearia-service\"} | select(resource.service.version, name, duration)",
        "tableType":"spans",
        "limit":50,
        "refId":"A"
      }],
      "transformations":[
        {"id":"organize","options":{
          "renameByName":{
            "traceIdHidden":"Trace ID",
            "spanID":"Span ID",
            "startTime":"Horário",
            "name":"Operação",
            "duration":"Duração (ms)",
            "resource.service.version":"Versão (commit)",
            "resource.service.name":"Serviço"
          },
          "indexByName":{"startTime":0,"resource.service.version":1,"name":2,"duration":3},
          "excludeByName":{"spanID":true,"traceIdHidden":false,"resource.service.name":true}
        }}
      ]
    },

    {"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":16},"id":1,"title":"Requests Recentes — clique em um trace para ver o percurso completo","type":"row"},
    {
      "datasource":{"type":"tempo","uid":"tempo"},
      "gridPos":{"h":20,"w":24,"x":0,"y":17},"id":10,
      "options":{"frameType":"traceList"},
      "title":"Todos os Traces — Tempo Total e Status","type":"table",
      "targets":[{
        "datasource":{"type":"tempo","uid":"tempo"},
        "queryType":"traceql",
        "query":"{resource.service.name=~\"$service\"}",
        "tableType":"traces",
        "limit":100,
        "refId":"A"
      }],
      "transformations":[
        {"id":"organize","options":{
          "renameByName":{
            "traceID":"Trace ID",
            "rootServiceName":"Serviço de Entrada",
            "rootTraceName":"Endpoint / Operação",
            "duration":"Duração Total (ms)",
            "startTime":"Horário"
          },
          "indexByName":{"startTime":0,"rootServiceName":1,"rootTraceName":2,"duration":3,"traceID":4}
        }}
      ]
    },

    {"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":38},"id":2,"title":"Traces Lentos — duração > 500ms","type":"row"},
    {
      "datasource":{"type":"tempo","uid":"tempo"},
      "gridPos":{"h":16,"w":24,"x":0,"y":39},"id":20,
      "options":{"frameType":"traceList"},
      "title":"Requests com alta latência (> 500ms) — inclui delays do demo.sh","type":"table",
      "targets":[{
        "datasource":{"type":"tempo","uid":"tempo"},
        "queryType":"traceql",
        "query":"{resource.service.name=~\"$service\" && duration > 500ms}",
        "tableType":"traces",
        "limit":50,
        "refId":"A"
      }],
      "transformations":[
        {"id":"organize","options":{"renameByName":{
          "traceID":"Trace ID","rootServiceName":"Serviço","rootTraceName":"Operação","duration":"Duração (ms)","startTime":"Horário"
        },"indexByName":{"duration":0,"rootServiceName":1,"rootTraceName":2,"startTime":3}}}
      ]
    },

    {"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":56},"id":3,"title":"Traces com Erro","type":"row"},
    {
      "datasource":{"type":"tempo","uid":"tempo"},
      "gridPos":{"h":16,"w":24,"x":0,"y":57},"id":30,
      "options":{"frameType":"traceList"},
      "title":"Traces com span de erro (status=error)","type":"table",
      "targets":[{
        "datasource":{"type":"tempo","uid":"tempo"},
        "queryType":"traceql",
        "query":"{resource.service.name=~\"$service\" && status=error}",
        "tableType":"traces",
        "limit":50,
        "refId":"A"
      }],
      "transformations":[
        {"id":"organize","options":{"renameByName":{
          "traceID":"Trace ID","rootServiceName":"Serviço","rootTraceName":"Operação","duration":"Duração (ms)","startTime":"Horário"
        }}}
      ]
    },

    {"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":74},"id":4,"title":"Processamento de Eventos","type":"row"},
    {
      "datasource":{"type":"tempo","uid":"tempo"},
      "gridPos":{"h":16,"w":24,"x":0,"y":75},"id":40,
      "options":{"frameType":"traceList"},
      "title":"Traces relacionados ao processamento de eventos","type":"table",
      "targets":[{
        "datasource":{"type":"tempo","uid":"tempo"},
        "queryType":"traceql",
        "query":"{resource.service.name=~\"agendamento-service|disponibilidade-service|notificacao-service\"}",
        "tableType":"traces",
        "limit":50,
        "refId":"A"
      }],
      "transformations":[
        {"id":"organize","options":{"renameByName":{
          "traceID":"Trace ID","rootServiceName":"Serviço","rootTraceName":"Operação","duration":"Duração (ms)","startTime":"Horário"
        },"indexByName":{"startTime":0,"rootServiceName":1,"rootTraceName":2,"duration":3}}}
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["traces","opentelemetry","tempo","distribuido"],
  "templating": {"list": [
    {"current":{"selected":true,"text":"All","value":"$__all"},"hide":0,"includeAll":true,"allValue":".*","multi":true,"name":"service","options":[
      {"selected":true,"text":"All","value":"$__all"},
      {"selected":false,"text":"bff-gateway","value":"bff-gateway"},
      {"selected":false,"text":"barbearia-service","value":"barbearia-service"},
      {"selected":false,"text":"agendamento-service","value":"agendamento-service"},
      {"selected":false,"text":"disponibilidade-service","value":"disponibilidade-service"},
      {"selected":false,"text":"notificacao-service","value":"notificacao-service"}
    ],"query":"bff-gateway,barbearia-service,agendamento-service,disponibilidade-service,notificacao-service","refresh":0,"sort":1,"type":"custom","label":"Serviço"}
  ]},
  "time": {"from":"now-1h","to":"now"}, "timepicker":{}, "timezone":"browser",
  "title": "Traces — Requests e Percurso Distribuído",
  "uid": "traces", "version": 1
}
