      "title":"Healthchecks 200 OK por Serviço (req/s)","type":"timeseries",
      "targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (service_name) (rate(app_http_server_duration_milliseconds_count{http_target=\"/health\",http_status_code=\"200\"}[$__rate_interval]))","legendFormat":"{{service_name}}","refId":"A"}]
    },

    {"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":15},"id":30,"title":"Latência dos Healthchecks","type":"row"},
    {
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"lineWidth":2,"fillOpacity":5},"unit":"ms"}},
      "gridPos":{"h":8,"w":24,"x":0,"y":16},"id":31,
      "options":{"legend":{"calcs":["mean","max"],"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "title":"Latência P95 do /health por Serviço","type":"timeseries",
      "targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"histogram_quantile(0.95, sum by (le, service_name) (rate(app_http_server_duration_milliseconds_bucket{http_target=\"/health\"}[$__rate_interval])))","legendFormat":"{{service_name}}","refId":"A"}]
    },

    {"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":24},"id":40,"title":"Erros — Taxa de Falhas por Serviço","type":"row"},
    {
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"lineWidth":2,"fillOpacity":15},"unit":"percentunit","min":0,"max":1}},
      "gridPos":{"h":8,"w":12,"x":0,"y":25},"id":41,
      "options":{"legend":{"calcs":["mean","max"],"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "title":"Taxa de Erros 5xx por Serviço","type":"timeseries",
      "targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (service_name) (rate(app_http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[$__rate_interval])) / sum by (service_name) (rate(app_http_server_duration_milliseconds_count{}[$__rate_interval]))","legendFormat":"{{service_name}}","refId":"A"}]
    },
    {
      "datasource":{"type":"prometheus","uid":"prometheus"},
      "fieldConfig":{"defaults":{"color":{"mode":"palette-classic"},"custom":{"lineWidth":1,"fillOpacity":10},"unit":"percentunit","min":0,"max":1}},
      "gridPos":{"h":8,"w":12,"x":12,"y":25},"id":42,
      "options":{"legend":{"calcs":["mean","max"],"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}},
      "title":"Taxa de Erros 4xx por Serviço","type":"timeseries",
      "targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (service_name) (rate(app_http_server_duration_milliseconds_count{http_status_code=~\"4..\"}[$__rate_interval])) / sum by (service_name) (rate(app_http_server_duration_milliseconds_count{}[$__rate_interval]))","legendFormat":"{{service_name}}","refId":"A"}]
    },

    {"collapsed":false,"gridPos":{"h":1,"w":24,"x":0,"y":33},"id":50,"title":"Logs de Erro — Loki","type":"row"},
    {
      "datasource":{"type":"loki","uid":"loki"},
      "gridPos":{"h":10,"w":24,"x":0,"y":34},"id":51,
      "options":{"dedupStrategy":"none","enableLogDetails":true,"prettifyLogMessage":false,"showCommonLabels":false,"showLabels":false,"showTime":true,"sortOrder":"Descending","wrapLogMessage":false},
      "title":"Logs de Erro recentes (ERROR / WARNING)","type":"logs",
      "targets":[
        {"datasource":{"type":"loki","uid":"loki"},"expr":"{service_name=~\".+\"} |~ \"(?i)(error|warning|warn|exception|critical|traceback)\" | line_format \"[{{.service_name}}] {{__line__}}\"","refId":"A","legendFormat":""}
      ]
    }
