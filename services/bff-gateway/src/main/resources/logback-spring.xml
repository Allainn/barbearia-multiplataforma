<?xml version="1.0" encoding="UTF-8"?>
<!--
  Adiciona um appender OTel ao lado do console, par direto do
  logging.getLogger().addHandler(handler) em telemetry.py dos serviços Python. A instância
  real do SDK OTel é injetada em runtime via OpenTelemetryAppender.install(sdk) em
  TelemetryConfig (o logback não tem acesso ao contexto Spring nesta config XML).
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender">
        <captureExperimentalAttributes>true</captureExperimentalAttributes>
        <captureCodeAttributes>true</captureCodeAttributes>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
